{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git-external Shijiu production writer mutex evidence",
  "type": "object",
  "required": [
    "shijiu_writer_source",
    "repository",
    "branch",
    "head_sha",
    "authorized_scopes",
    "concurrent_shijiu_writer_observed",
    "exclusive_window_confirmed",
    "confirmation_basis",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "shijiu_writer_source": {"const": "MIKIHOUSE"},
    "repository": {"const": "qinxitong8666/mikihouse-luyao"},
    "branch": {"const": "main"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorized_scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["product_number", "allowed_stage_keys"],
        "properties": {
          "product_number": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{4}-[0-9]{3}$"},
          "allowed_stage_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "concurrent_shijiu_writer_observed": {"const": false},
    "exclusive_window_confirmed": {"const": true},
    "confirmation_basis": {
      "enum": ["external_coordination", "shared_scheduler", "operator_confirmed_global_window"]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
